---
import Layout from '@layouts/Layout.astro';
import Header from '@components/site/header/Header.astro';
import Footer from '@components/site/footer/Footer.astro';
import Hero from '@components/portfolio/hero/Hero.astro';
import Projects from '@components/portfolio/projects/Projects.astro';
// import SectionIndicator from '@components/portfolio/section-indicator/SectionIndicator.astro';
---

<Layout>
  <Header />
  <main class="page">
    <Hero />
    <div class="sections">
      <Projects featured />
    </div>
  </main>
  <Footer />
  <!-- <SectionIndicator /> -->
</Layout>

<style>
  .sections {
    padding-inline: var(--page-gutter);
    display: flow-root;
  }
</style>
