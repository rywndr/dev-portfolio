---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import TechStack from '../components/TechStack.astro';
---

<Layout>
  <main class="page">
    <div class="portrait">
      <img src="/portrait.webp" alt="Haikhal Roywendra" />
    </div>
    <h1>Haikhal Roywendra</h1>
    <SocialLinks />
    <p>
      I am a former computer and network engineering student, currently studying
      computer science in Indonesia. I build web apps, explore cloud computing,
      and am learning DevOps.
    </p>
    <TechStack />
  </main>
</Layout>

<style>
  h1 {
    margin-bottom: 0.75rem;
  }

  .portrait {
    width: clamp(5rem, 9vw, 7rem);
    aspect-ratio: 1;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid var(--color-muted);
    border-radius: 50%;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
