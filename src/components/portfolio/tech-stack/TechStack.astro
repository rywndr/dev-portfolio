---
import { technologies } from './technologies';
---

<section class="portfolio-section" aria-labelledby="tech-heading">
  <h2 id="tech-heading">&lt;tech I use&gt;</h2>
  <ul role="list">
    {
      technologies.map(({ name, icon }) => (
        <li>
          <span
            class="tech-icon"
            aria-hidden="true"
            style={'--icon: url(' + icon + ')'}
          />
          <span>{name}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    max-width: 100%;
    gap: 0.5rem;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid #303030;
    border-radius: 999px;
    background: #191919;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  .tech-icon {
    display: block;
    width: 1rem;
    height: 1rem;
    flex: 0 0 1rem;
    background: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
</style>
