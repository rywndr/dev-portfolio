---
import { Image } from 'astro:assets';
import type { Project } from './projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<li class:list={{ 'without-preview': !project.image }}>
  {
    project.image && (
      <div class="preview" aria-hidden="true">
        <Image src={project.image} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="details">
    <div class="project-heading">
      <h3>{project.name}</h3>
      <div class="project-links">
        {
          project.source.kind === 'open-source' && (
            <a
              class="project-link github-link"
              href={project.source.github}
              aria-label={`${project.name} on GitHub`}
            >
              <span class="github-icon" aria-hidden="true" />
            </a>
          )
        }
        <a
          class="project-link live-link"
          href={project.live}
          aria-label={`${project.name} live site`}
        >
          live
        </a>
      </div>
    </div>
    <p class="description">{project.description}</p>
    <div class="metadata">
      <ul
        class="technologies"
        role="list"
        aria-label={`${project.name} technologies`}
      >
        {
          project.technologies.map(({ name, icon }) => (
            <li>
              <span
                class="tech-icon"
                aria-hidden="true"
                style={'--icon: url(' + icon + ')'}
              />
              <span>{name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</li>

<style>
  li {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .without-preview {
    grid-template-columns: minmax(0, 1fr);
  }

  .without-preview .description {
    max-width: 65ch;
  }

  .preview {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .preview img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .details {
    padding-top: 0.25rem;
  }

  .project-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  h3 {
    min-width: 0;
    margin: 0;
    font-family: 'Times New Roman', Times, 'Liberation Serif', serif;
    font-size: clamp(1.5rem, 2.5vw, 1.75rem);
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .description {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 1rem;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .technologies {
    display: flex;
    flex: 1 1 100%;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
  }

  .technologies li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .project-links {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.75rem;
  }

  .project-link {
    min-height: 2rem;
    border: 1px solid currentColor;
    color: var(--color-muted);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    padding: 0;
  }

  .github-icon {
    display: block;
    width: 1rem;
    height: 1rem;
    background: currentColor;
    -webkit-mask: url('/github.svg') center / contain no-repeat;
    mask: url('/github.svg') center / contain no-repeat;
  }

  .live-link {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    line-height: 1.5;
  }

  .project-link:hover,
  .project-link:focus-visible {
    background: var(--color-muted);
    color: var(--color-background);
    text-decoration: none;
  }

  .tech-icon {
    display: block;
    width: 1rem;
    height: 1rem;
    flex: 0 0 1rem;
    background: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  @media (max-width: 48rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
