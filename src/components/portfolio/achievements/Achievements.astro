---
import { Image } from 'astro:assets';

import { achievements } from './achievements';
---

<section class="portfolio-section" aria-labelledby="achievements-heading">
  <h2 id="achievements-heading">&lt;achievements&gt;</h2>
  {
    achievements.map((achievement) => (
      <article class="achievement" aria-labelledby={achievement.headingId}>
        <Image
          src={achievement.image}
          alt={achievement.imageAlt}
          loading="lazy"
          decoding="async"
        />
        <div class="details">
          <p class="dates">{achievement.dates}</p>
          <h3 id={achievement.headingId}>{achievement.title}</h3>
          <p class="description">{achievement.description}</p>
          <nav class="links" aria-label={achievement.linksLabel}>
            {achievement.links.map((link) => (
              <a href={link.href} aria-label={link.ariaLabel}>
                <span
                  class:list={['link-icon', `${link.icon}-icon`]}
                  aria-hidden="true"
                />
                <span>{link.label}</span>
              </a>
            ))}
          </nav>
        </div>
      </article>
    ))
  }
</section>

<style>
  .achievement {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
    padding-left: 0;
  }

  .dates {
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .description {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 1rem;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem;
    color: var(--color-muted);
  }

  .links a:hover {
    text-decoration: none;
  }

  .link-icon {
    display: block;
    width: 1rem;
    height: 1rem;
    background: currentColor;
  }

  .medium-icon {
    -webkit-mask: url('/medium.svg') center / contain no-repeat;
    mask: url('/medium.svg') center / contain no-repeat;
  }

  .x-icon {
    -webkit-mask: url('/x.svg') center / contain no-repeat;
    mask: url('/x.svg') center / contain no-repeat;
  }

  @media (max-width: 32rem) {
    .achievement {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    img {
      width: min(100%, 20rem);
    }
  }
</style>
