---
type ProjectSource =
  { kind: 'open-source'; github: string } | { kind: 'closed-source' };

type Project = {
  name: string;
  image: string | null;
  source: ProjectSource;
};

const projects: Project[] = [
  { name: 'AfiDu', image: null, source: { kind: 'open-source', github: '#' } },
  {
    name: 'A&A Counsellors at Law',
    image: '/projects/aalaw.webp',
    source: { kind: 'closed-source' },
  },
  {
    name: 'Habits+',
    image: null,
    source: { kind: 'open-source', github: '#' },
  },
  {
    name: 'Huntsman e-commerce',
    image: null,
    source: { kind: 'open-source', github: '#' },
  },
  {
    name: 'Mirai',
    image: '/projects/mirai-console.webp',
    source: { kind: 'closed-source' },
  },
  {
    name: 'TikTok Dapp',
    image: '/projects/tiktok-dapp.png',
    source: { kind: 'open-source', github: '#' },
  },
];
---

<section
  id="projects"
  class="portfolio-section"
  aria-labelledby="projects-heading"
>
  <h2 id="projects-heading">&lt;projects&gt;</h2>
  <ul class="projects" role="list">
    {
      projects.map((project) => (
        <li>
          <div class="preview" aria-hidden="true">
            {project.image && (
              <img src={project.image} alt="" loading="lazy" decoding="async" />
            )}
          </div>
          <div class="details">
            <h3>{project.name}</h3>
            <p class="description">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
              eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
            <div class="metadata">
              <span>&lt;tech&gt;</span>
              {project.source.kind === 'open-source' ? (
                <a
                  href={project.source.github}
                  aria-label={`${project.name} on GitHub`}
                >
                  github
                </a>
              ) : (
                <span>&lt;closed-source&gt;</span>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  .preview {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .details {
    padding-top: 0.25rem;
  }

  h3 {
    margin: 0;
    font-family: 'Times New Roman', Times, 'Liberation Serif', serif;
    font-size: clamp(1.5rem, 2.5vw, 1.75rem);
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .description {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (max-width: 40rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
