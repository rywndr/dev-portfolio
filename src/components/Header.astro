---
import { sections } from '../data/sections.js';
import { cvUrl } from '../data/site.js';
---

<header>
  <nav aria-label="Main navigation">
    <ul class="section-links" role="list">
      {
        sections.map((section) => (
          <li>
            <a href={`#${section}`}>{section}</a>
          </li>
        ))
      }
    </ul>
    <div class="cv">
      {
        cvUrl ? (
          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CV PDF, opens in a new tab"
          >
            CV <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <>
            <button
              type="button"
              id="cv-button"
              aria-describedby="cv-status"
              disabled
            >
              <span class="cv-label">CV</span>
              <span aria-hidden="true">↗</span>
            </button>
            <span id="cv-status" role="status" />
            <noscript>CV is not ready</noscript>
          </>
        )
      }
    </div>
  </nav>
</header>

<style>
  header {
    padding: 1.5rem var(--page-gutter) 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem clamp(1rem, 3vw, 2rem);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem clamp(1rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  a,
  button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.25rem;
  }

  button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  button:hover .cv-label,
  button:focus-visible .cv-label {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  [role='status'] {
    position: absolute;
    top: 100%;
    right: 0;
    white-space: nowrap;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

</style>

<script>
  const cvButton = document.getElementById('cv-button');
  const cvStatus = document.getElementById('cv-status');

  if (cvButton instanceof HTMLButtonElement && cvStatus) {
    let feedbackTimer: ReturnType<typeof window.setTimeout> | undefined;
    cvButton.disabled = false;

    cvButton.addEventListener('click', () => {
      window.clearTimeout(feedbackTimer);
      cvStatus.textContent = 'CV is not ready';
      feedbackTimer = window.setTimeout(() => {
        cvStatus.textContent = '';
      }, 3000);
    });
  }
</script>
