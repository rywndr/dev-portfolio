---
const sections = ['experience', 'education', 'projects', 'achievements'];
---

<header>
  <nav aria-label="Main navigation">
    <ul role="list">
      {
        sections.map((section) => (
          <li>
            <a href={`#${section}`}>{section}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    padding: 1.5rem var(--page-gutter) 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem clamp(1rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
