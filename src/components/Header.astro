---
import { sections } from '../data/sections.js';
import { cvUrl } from '../data/site.js';
import LocaleSwitcher from './LocaleSwitcher.astro';
---

<header>
  <nav aria-label="Main navigation">
    <ul class="section-links" role="list">
      {
        sections.map((section) => (
          <li>
            <a href={`#${section}`}>{section}</a>
          </li>
        ))
      }
    </ul>
    <div class="utilities">
      <a
        href={cvUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="CV PDF, opens in a new tab"
      >
        CV <span aria-hidden="true">↗</span>
      </a>
      <LocaleSwitcher />
    </div>
  </nav>
</header>

<style>
  header {
    padding: 1.5rem var(--page-gutter) 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem clamp(1rem, 3vw, 2rem);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem clamp(1rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .utilities {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.25rem;
  }
</style>
