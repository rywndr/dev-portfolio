---
import '../styles/timeline.css';
---

<section
  id="experience"
  class="portfolio-section"
  aria-labelledby="experience-heading"
>
  <h2 id="experience-heading">&lt;experience&gt;</h2>
  <ol class="timeline" role="list">
    <li>
      <p class="dates">
        <time datetime="2022">2022</time> &ndash; <time datetime="2025"
          >2025</time
        >
      </p>
      <h3>Freelance full-stack developer</h3>
      <p class="description">
        Built full-stack web and decentralized applications for freelance
        projects, working across frontend interfaces, backend systems, APIs,
        databases, and blockchain-based features.
      </p>
    </li>
    <li>
      <p class="dates">
        <time datetime="2021-01">January 2021</time> &ndash;
        <time datetime="2021-06">June 2021</time>
      </p>
      <h3>Computer technician intern</h3>
      <p class="organization">Epro Tech</p>
      <p class="description">
        Serviced, built, and troubleshot computers and printers, while helping
        customers choose suitable computer parts and networking equipment.
      </p>
    </li>
  </ol>
</section>
