---
const technologies = [
  'React',
  'Next.js',
  'JavaScript',
  'TypeScript',
  'Tailwind CSS',
  'PostgreSQL',
  'Docker',
  'Python',
  'Linux',
  'Git',
];
---

<section id="tech" class="portfolio-section" aria-labelledby="tech-heading">
  <h2 id="tech-heading">&lt;tech I use&gt;</h2>
  <ul role="list">
    {technologies.map((technology) => <li>{technology}</li>)}
  </ul>
</section>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
</style>
