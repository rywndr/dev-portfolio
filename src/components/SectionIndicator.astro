---
import { sections } from '../data/sections.js';
---

<nav class="section-indicator" aria-label="Section navigation">
  <ol role="list">
    {
      sections.map((section) => (
        <li>
          <a href={`#${section}`}>
            <span class="dot" aria-hidden="true" />
            <span>{section}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const navigation = document.querySelector('.section-indicator');

  if (navigation) {
    const entries = Array.from(navigation.querySelectorAll('a')).flatMap(
      (link) => {
        const section = document.getElementById(link.hash.slice(1));
        return section ? [{ link, section }] : [];
      },
    );
    const desktop = window.matchMedia('(min-width: 75rem)');
    let scheduled = false;

    function update() {
      scheduled = false;
      if (!desktop.matches) return;

      const readingLine = Math.min(window.innerHeight * 0.3, 240);
      let activeId = '';
      for (const { section } of entries) {
        if (section.getBoundingClientRect().top <= readingLine) {
          activeId = section.id;
        }
      }

      // The last section may be too short to reach the reading line.
      const last = entries.at(-1);
      const atBottom =
        window.scrollY > 0 &&
        window.scrollY + window.innerHeight >=
          document.documentElement.scrollHeight - 2;
      if (atBottom && last) activeId = last.section.id;

      for (const { link, section } of entries) {
        if (section.id === activeId) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    }

    function scheduleUpdate() {
      if (scheduled || !desktop.matches) return;
      scheduled = true;
      window.requestAnimationFrame(update);
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);
    desktop.addEventListener('change', scheduleUpdate);
    document.fonts.ready.then(scheduleUpdate);
    update();
  }
</script>

<style>
  .section-indicator {
    display: none;
  }

  @media (min-width: 75rem) {
    .section-indicator {
      display: block;
      position: fixed;
      top: 50%;
      right: 1rem;
      transform: translateY(-50%);
      z-index: 2;
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
  }

  li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(2rem + 3.5px);
    top: calc(50% + 4px);
    bottom: calc(-50% + 4px);
    width: 1px;
    background: var(--color-muted);
    opacity: 0.35;
    pointer-events: none;
  }

  a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-left: 2rem;
    color: var(--color-muted);
  }

  .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  a[aria-current='location'] {
    color: var(--color-text);
  }

  a[aria-current='location'] .dot {
    background: currentColor;
  }
</style>
