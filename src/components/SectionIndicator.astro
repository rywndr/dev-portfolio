---
import { sections } from '../data/sections.js';
---

<section-indicator role="navigation" aria-label="Section navigation">
  <ol role="list">
    {
      sections.map((section) => (
        <li>
          <a href={`#${section}`} draggable="false">
            <span class="tick" aria-hidden="true" />
            <span class="label">{section}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section-indicator>

<script src="./SectionIndicator.ts"></script>

<style>
  /* Keep hidden on small screens and before a section is active. */
  section-indicator {
    display: none;
  }

  @media (min-width: 75rem) {
    section-indicator:has(a[aria-current]) {
      display: block;
      position: fixed;
      top: 50%;
      right: 0.75rem;
      z-index: 2;
      transform: translateY(-50%);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      user-select: none;
      touch-action: none;
    }
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
  }

  a {
    position: relative;
    display: flex;
    align-items: center;
    width: 2.75rem;
    height: 1.5rem;
    padding-left: 0.5rem;
    cursor: grab;
  }

  .tick,
  li:not(:last-child)::after {
    width: 6px;
    height: 2px;
    background: color-mix(in srgb, var(--color-muted) 35%, transparent);
    transform-origin: left;
  }

  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(100% - 1px);
    left: 0.5rem;
    pointer-events: none;
  }

  a[aria-current] .tick {
    width: 10px;
    background: var(--color-text);
  }

  .label {
    position: absolute;
    right: calc(100% + 0.5rem);
    color: var(--color-text);
    opacity: 0;
    transform: translateX(4px);
    pointer-events: none;
  }

  section-indicator:is(:hover, :focus-within, [data-dragging]) .tick {
    width: 12px;
  }

  section-indicator:is(:hover, :focus-within, [data-dragging]) li::after {
    width: 10px;
  }

  section-indicator:is(:hover, :focus-within, [data-dragging])
    :is(a[aria-current], a:hover, a:focus-visible, a[data-target])
    .tick {
    width: 26px;
  }

  section-indicator:is(:hover, :focus-within, [data-dragging])
    li:has(+ li a[aria-current])::after,
  section-indicator:is(:hover, :focus-within, [data-dragging])
    li:has(a[aria-current])::after {
    /* Keep the expanded active tick connected to the ticks around it. */
    width: 18px;
  }

  /* Hide the active label when another link is hovered or focused. */
  section-indicator:not([data-dragging]):is(:hover, :focus-within):not(
      :has(a:not([aria-current]):is(:hover, :focus-visible))
    )
    a[aria-current]
    .label,
  section-indicator:not([data-dragging]) a:is(:hover, :focus-visible) .label,
  a[data-target] .label {
    opacity: 1;
    transform: translateX(0);
  }

  a[data-target] .tick {
    background: var(--color-text);
  }

  [data-dragging] a {
    cursor: grabbing;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tick,
    li::after {
      transition:
        width 160ms ease,
        background-color 160ms ease;
    }

    .label {
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }
  }
</style>
