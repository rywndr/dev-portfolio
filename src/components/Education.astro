---
import '../styles/timeline.css';
---

<section
  id="education"
  class="portfolio-section"
  aria-labelledby="education-heading"
>
  <h2 id="education-heading">&lt;education&gt;</h2>
  <ol class="timeline" role="list">
    <li>
      <p class="dates"><time datetime="2022">2022</time> &ndash; present</p>
      <h3>Information Systems</h3>
      <p class="organization">
        Sekolah Tinggi Teknologi Indonesia Tanjung Pinang
      </p>
      <p class="description">
        <span class="mono">&lt;org&gt;</span> MARS (Student Robotics Association)
      </p>
    </li>
    <li>
      <p class="dates">
        <time datetime="2020">2020</time> &ndash; <time datetime="2022"
          >2022</time
        >
      </p>
      <h3>Computer and network engineering</h3>
      <p class="organization">SMK Negeri 1 Tanjungpinang</p>
    </li>
  </ol>
</section>
