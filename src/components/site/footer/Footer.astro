---
import SocialLinks from '@components/site/contact/SocialLinks.astro';
import EmailCopy from '@components/site/contact/EmailCopy.astro';
---

<footer id="contact" aria-labelledby="contact-heading">
  <div class="footer-content">
    <h2 id="contact-heading" class="section-heading">&lt;contact&gt;</h2>
    <p>Want to collaborate? Let's talk.</p>
  </div>
  <div class="contact-row">
    <EmailCopy />
    <nav aria-label="Social profiles">
      <SocialLinks />
    </nav>
  </div>
</footer>

<style>
  footer {
    padding: 0 var(--page-gutter) 3rem;
    scroll-margin-top: 2rem;
  }

  .footer-content {
    max-width: var(--section-width);
    border-top: 1px solid #303030;
    padding-top: 2rem;
  }

  p {
    margin-bottom: 1rem;
    font-size: 1.125rem;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  nav {
    margin-left: auto;
  }

  footer :global(.social-links) {
    justify-content: flex-end;
    margin: 0;
  }

  footer :global(.social-links a) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
