---
import SocialLinks from '@components/site/contact/SocialLinks.astro';
---

<footer>
  <div class="contact-row">
    <p>&copy; {new Date().getFullYear()} Haikhal Roywendra</p>
    <nav aria-label="Social profiles">
      <SocialLinks />
    </nav>
  </div>
</footer>

<style>
  footer {
    padding: 0 var(--page-gutter) 3rem;
    scroll-margin-top: 2rem;
  }

  p {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .contact-row {
    border-top: 1px solid
      color-mix(in srgb, var(--color-muted) 20%, transparent);
    padding-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  nav {
    margin-left: auto;
  }

  footer :global(.social-links) {
    justify-content: flex-end;
    margin: 0;
  }

  footer :global(.social-links a) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
