---
import { socialLinks } from './links';
---

<ul class="social-links" aria-label="Social links">
  {
    socialLinks.map(({ label, href, icon }) => (
      <li>
        <a href={href} aria-label={label} target="_blank">
          <img src={icon} alt="" width="16" height="16" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
  }

  img {
    display: block;
    width: 1rem;
    height: 1rem;
  }
</style>
